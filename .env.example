# Public site URL — used for OG/Twitter canonical metadata.
# Local dev:        http://localhost:3000
# Production:       https://crookscodes.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form (server-only — used by app/api/contact) ─────────────────────
# Supabase project URL and SERVICE-ROLE key. The service-role key bypasses
# RLS, so it must never be exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron — shared secret for /api/cron/keep-alive, which pings Supabase
# daily so the free-tier project never gets paused for inactivity. Vercel sends
# it as `Authorization: Bearer $CRON_SECRET`. Generate with:
#   openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Resend — contact-form email notifications.
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=CrooksCodes <onboarding@resend.dev>

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# /admin reuses SUPABASE_URL above. If any of these is missing or malformed,
# /admin answers 503 and serves nothing (fail closed).
#
# Publishable key (sb_publishable_... or the legacy anon JWT). Server-only by
# convention here: there is no browser Supabase client. A secret or
# service-role key is rejected, because it would bypass RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# auth.users id of the single account allowed into /admin. The database checks
# the same thing through private.admin_owner.
ADMIN_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
